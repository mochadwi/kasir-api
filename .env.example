# Server Configuration
PORT=8080

# Neon Database (no quotes around the URL)
# Get this from Neon Dashboard → Connection String → pooled
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/[DBNAME]?sslmode=require

# Alternative: Direct connection (for local development, not recommended for serverless)
# DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[HOST].[REGION].aws.neon.tech/[DBNAME]?sslmode=require
